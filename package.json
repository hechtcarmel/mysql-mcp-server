{
  "name": "@hechtcarmel/mysql-mcp-server",
  "version": "2.0.0",
  "description": "A Model Context Protocol (MCP) server that provides LLMs with flexible, safe access to MySQL databases",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mysql-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "prepack": "npm run clean && npm run build",
    "test:package": "node scripts/test-package.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mysql",
    "database",
    "llm",
    "ai",
    "claude",
    "anthropic"
  ],
  "author": "Carmel Hecht",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hechtcarmel/mysql-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/hechtcarmel/mysql-mcp-server/issues"
  },
  "homepage": "https://github.com/hechtcarmel/mysql-mcp-server#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "dotenv": "^17.2.3",
    "mysql2": "^3.24.6",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@10.28.2",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    ".env.example",
    "docs",
    "scripts/local-smoke.mjs",
    "scripts/smoke-transport.mjs",
    "scripts/local-tls-probe.mjs"
  ]
}

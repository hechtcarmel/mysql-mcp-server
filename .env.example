# Required: use a dedicated account with the minimum database privileges.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_username
MYSQL_PASSWORD=your_password

# Safe default. Only the literal true (case-insensitive) enables writes.
MYSQL_ALLOW_WRITE=false

# Existing limits, in milliseconds where applicable.
MYSQL_POOL_SIZE=10
MYSQL_CONNECTION_TIMEOUT=10000
MYSQL_QUERY_TIMEOUT=30000

# Retained rows per call, shared across batch statements.
MYSQL_MAX_ROWS=1000

# Optional default database. Prefer database.table names for cross-database access.
# MYSQL_DATABASE=mydb

# Select a file from your MCP client's environment. Shell variables take precedence.
# MYSQL_ENV_FILE=/absolute/path/to/mysql.env

# TLS with system trust, or provide a CA file (which also enables TLS).
# MYSQL_SSL=true
# MYSQL_SSL_CA=/absolute/path/to/ca.pem
# Client certificates require both cert and key.
# MYSQL_SSL_CERT=/absolute/path/to/client-cert.pem
# MYSQL_SSL_KEY=/absolute/path/to/client-key.pem
# MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Optional only for endpoints requesting mysql_clear_password. Disabled by default.
# Requires TLS 1.2+, certificate verification and a matching DNS MYSQL_HOST.
# IP literals and MYSQL_SSL_REJECT_UNAUTHORIZED=false are refused for this mode.
# MYSQL_ENABLE_CLEARTEXT_PLUGIN=false
